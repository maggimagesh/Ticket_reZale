# Supabase project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string used to sign session JWTs (generate your own)
JWT_SECRET=change-me-to-a-long-random-secret

# Free key from https://www.themoviedb.org/settings/api — powers movie dropdown
TMDB_API_KEY=your-tmdb-api-key

# Optional: protect /api/chat/cleanup (Vercel Cron sends Authorization: Bearer …)
# CRON_SECRET=long-random-secret

# Browser-side Realtime (WSS) — Settings → API → Publishable key.
# Safe to expose: RLS grants it no table access; it only subscribes to the
# listings broadcast channel, which carries ids and statuses, never rows.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx`
